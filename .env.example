# Frozen thesis production defaults. Only change these intentionally.
DAPURIA_MODEL_NAME=LazarusNLP/all-indo-e5-small-v4
DAPURIA_COLLECTION_NAME=resep_masakan
DAPURIA_TOP_K_SBERT=50
DAPURIA_MAX_KEYWORD_EXTRA=20
DAPURIA_SEMANTIC_WEIGHT=0.9
DAPURIA_INGREDIENT_WEIGHT=0.1
DAPURIA_TOP_N=5
DAPURIA_MIN_INGREDIENT_COUNT=1

# Ollama / Llama 3
DAPURIA_OLLAMA_URL=http://localhost:11434
DAPURIA_OLLAMA_MODEL=llama3
DAPURIA_OLLAMA_TIMEOUT=60

# Optional paths. Relative paths are resolved from the working directory.
# DAPURIA_CHROMA_DIR=data/chroma_db
# DAPURIA_CORPUS_PATH=data/corpus/recipes.csv
# DAPURIA_HISTORY_PATH=data/local_history/chats.sqlite3
